# ============================================================
# Traffic Accident Severity Analytics — Environment Variables
# ============================================================
# Copy this file to .env and fill in actual values.
# NEVER commit the .env file to version control.
# ============================================================

# ---- PostgreSQL / PostGIS ----
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=traffic_accidents
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# ---- Open-Meteo API ----
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive

# ---- MLflow ----
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=traffic-accident-severity

# ---- FastAPI Inference Service ----
API_HOST=0.0.0.0
API_PORT=8000

# ---- Streamlit ----
STREAMLIT_PORT=8501

# ---- Data Directories ----
DATA_DIR=./data

# ---- Weather Cache ----
WEATHER_CACHE_DB=./data/weather_cache.db

# ---- Pipeline Configuration ----
# Set to 'true' to use demo data instead of downloading full datasets
DEMO_MODE=true

# Number of records to sample for weather enrichment (set to 0 for all)
SAMPLE_SIZE=1000

# UK Road Safety data years to download (comma-separated)
ACCIDENT_YEARS=2022,2023

# ---- Model Configuration ----
MODEL_NAME=traffic_accident_severity_model
MODEL_STAGE=Production

# ---- Monitoring Thresholds ----
DRIFT_PSI_THRESHOLD=0.20
MIN_RECALL_THRESHOLD=0.50
MIN_MACRO_F1_THRESHOLD=0.60
MAX_FALSE_NEGATIVE_RATE=0.15
RETRAINING_MIN_NEW_RECORDS=10000

# ---- Airflow ----
AIRFLOW_HOME=./airflow
AIRFLOW__CORE__EXECUTOR=SequentialExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
